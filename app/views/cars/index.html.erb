<style>
  .Cars {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;
      }
  .Container {
     background: #f8f9fa;
      text-align: center;
  }
  h1.display {
      font-size: 2.5rem;
      margin-top: 0;
  }
</style>

<p style="color: green"><%= notice %></p>

<div class="Container">
 <h1 class="display">Cars</h1>
 <h2>Here are the available cars</h2>
</div>

<% if @cars.empty? %>
  <p>No cars available.</p>
<% end %>
<div class="Cars">
  <% @cars.each do |car| %>
    <%= render car %>
  <% end %>
</div>

