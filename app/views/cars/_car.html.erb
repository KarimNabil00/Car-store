<% if @cars.present? %>
    <div class="Car" id="car_<%= car.id %>">
      <h3>
        <%= link_to "#{car.make} #{car.model}", car %>
        </h3>
      <p>Year: <%= car.year %></p>
      <p>Color: <%= car.color %></p>
      <p>Price: $<%= number_with_delimiter(car.price, delimiter: ',') %></p>
      <p>Description: <%= car.description %></p>
      <p>Available: <%= car.available ? 'Yes' : 'No' %></p>
    </div>
<% end %>
<style>
  .Car-Content img {
      width: 400px;
      display : flex;
  }
  .Car {
      text-align: center;
  }  
</style>
