<% if @cars.present? %>
    <div class="Car" id="car_<%= car.id %>">
      <div class="Car-image">
        <% if car.image.attached? %>
          <%= image_tag car.image, style: "height: auto;" %>
        <% else %> 
          <p>No image available for this car.</p>
        <% end %>  
      </div>
      <h3 class="Car-tiltle">
        <%= link_to "#{car.make.name} #{car.car_model.name}", car %>
        </h3>
      <p>Year: <%= car.year %></p>
      <p>Color: <%= car.color %></p>
      <p class="car-price">Price: $<%= number_with_delimiter(car.price, delimiter: ',') %></p>
    </div>
<% end %>
<style>
  .Car-image img {
      width: 30rem;
      display : flex;
  }
  .Car {
      text-align: center;
  }  
</style>
