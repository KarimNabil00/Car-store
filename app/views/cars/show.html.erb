<style>
  .car-show {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem;;
  }
  .card-img-top {
    width: 40rem;
    height: auto;
  }
   .btn.btn-primary {
    background-color: #007bff;
    border-color: #007bff;
   color: white;
   }
   .btn.btn-secondary {
    color: white; 
    }
  </style>
<div class="car-show">
  <!-- Hero Section with Car Image -->
  <div class="car-hero">
    <% if @car.image.attached? %>
      <%= image_tag @car.image, alt: "#{@car.make.name} #{@car.car_model.name}", class:"card-img-top" %>
    <% end %>
  </div>

  <!-- Main Content -->
  <div class="car-details">
    <h1><%= @car.make.name %> <%= @car.car_model.name %></h1>
    <h2><%= @car.year %> • <%= number_to_currency(@car.price) %></h2>

    <!-- Description -->
    <div class="description">
      <h3>Description</h3>
      <p><%= @car.description %></p>
    </div>

    <!-- Specifications Table -->
    <div class="specs">
      <h3>Specifications</h3>
      <table>
        <tr>
          <th>Make</th>
          <td><%= @car.make.name %></td>
        </tr>
        <tr>
          <th>Model</th>
          <td><%= @car.car_model.name %></td>
        </tr>
        <tr>
          <th>Year</th>
          <td><%= @car.year %></td>
        </tr>
        <tr>
          <th>Color</th>
          <td><%= @car.color %></td>
        </tr>
      </table>
    </div>

    <!-- Call to Action -->
    <div class="cta">
      <%= link_to "Contact Seller", new_car_order_path(@car), class: "btn btn-primary" %>
      <%= link_to "Back to Inventory", cars_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>