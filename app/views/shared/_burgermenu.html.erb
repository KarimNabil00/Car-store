<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <style>
    <link rel="stylesheet" href="/assets/burgermenu.css" />
  </style>
</head>

<body>

  <div class="off-screen-menu" id="menu">
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/cars">Cars On Sale</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/sign_up">Sign Up</a></li>
    </ul>
  </div>

  <nav>
    <div class="ham-menu" id="ham-menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </div>
    <div class="site-name">MySite</div>
  </nav>

  <script>
    var burger = document.getElementById('ham-menu');
    var menu = document.getElementById('menu');

    burger.addEventListener('click', () => {
      menu.classList.toggle('active');
    });
  </script>

</body>
</html>
