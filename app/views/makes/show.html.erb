<style>
  .Cars {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;
      }
  .Container {
     background: #f8f9fa;
      text-align: center;
  }
  h1.display {
      font-size: 2.5rem;
      margin-top: 0;
  }
</style>
<div class="Container">
<h1><%= @make.name %> Cars</h1>
</div>

<% if @cars.empty? %>
  <p>No cars available for this maker.</p>
<% else %>
  <div class="Cars">
    <% @cars.each do |car| %>
      <%= render car %>
    <% end %>
  </div>
<% end %>
